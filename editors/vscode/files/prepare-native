#!/bin/sh
set -eu
files=$1
localbase=$2

# Keep the JavaScript host paired with the installed esbuild service.
for module in node_modules/.pnpm/esbuild@*/node_modules/esbuild \
    build/node_modules/.pnpm/esbuild@*/node_modules/esbuild; do
    install -m 644 "$localbase/node/electron-esbuild/node_modules/esbuild/lib/main.js" \
        "$module/lib/main.js.new"
    mv "$module/lib/main.js.new" "$module/lib/main.js"
done

for patch in "$files"/native/*.patch; do
    /usr/bin/patch -s -f -V none -p0 < "$patch"
done
cd node_modules/@parcel/watcher
for patch in "$files"/watcher/*.patch; do
    /usr/bin/patch -s -f -V none -p0 < "$patch"
done
