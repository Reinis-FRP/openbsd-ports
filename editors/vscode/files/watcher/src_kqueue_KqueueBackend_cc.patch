+void KqueueBackend::removePath(const std::string &path, bool directory, std::unordered_set<WatcherRef> &watchers) {
+  std::vector<std::string> paths{path};
+  if (directory) {
+    const std::string prefix = path + DIR_SEP;
+    for (const auto &registration : mRegistrations) {
+      if (registration.second.path.rfind(prefix, 0) == 0) {
+        paths.push_back(registration.second.path);
+      }
+    }
+  }
+  for (const auto &removed : paths) {
+    auto subs = findSubscriptions(removed);
+    if (subs.empty()) {
+      continue;
+    }
+    int fd = subs.front()->fd;
+    for (auto sub : subs) {
+      sub->watcher->mEvents.remove(removed);
+      watchers.insert(sub->watcher);
+      sub->tree->remove(removed);
+    }
+    mSubscriptions.erase(removed);
+    mRegistrations.erase(fd);
+    close(fd);
+  }
+}
