"""Run against a staged or installed pdfcraft-cli, or write an X11 test fixture."""
import json
import os
from pathlib import Path
import struct
import subprocess
import sys
import tempfile
import zlib


def stream(data, entries=b""):
    return (b"<< " + entries + b" /Length " + str(len(data)).encode()
            + b" >>\nstream\n" + data + b"\nendstream")


def write_pdf(path, objects):
    data = bytearray(b"%PDF-1.4\n")
    offsets = []
    for index, obj in enumerate(objects, 1):
        offsets.append(len(data))
        data.extend(f"{index} 0 obj\n".encode() + obj + b"\nendobj\n")
    xref = len(data)
    size = len(objects) + 1
    data.extend(f"xref\n0 {size}\n0000000000 65535 f \n".encode())
    for offset in offsets:
        data.extend(f"{offset:010} 00000 n \n".encode())
    data.extend(f"trailer\n<< /Size {size} /Root 1 0 R >>\nstartxref\n{xref}\n%%EOF\n".encode())
    path.write_bytes(data)


CATALOG = b"<< /Type /Catalog /Pages 2 0 R >>"


def fixture(path):
    page = b"<< /Type /Page /Parent 2 0 R /Resources << /Font << /F1 5 0 R >> >> /Contents "
    write_pdf(path, [
        CATALOG, b"<< /Type /Pages /Kids [3 0 R 4 0 R] /Count 2 /MediaBox [0 0 240 120] >>",
        page + b"6 0 R >>", page + b"7 0 R >>",
        b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>",
        stream(b"BT /F1 24 Tf 35 55 Td (ORCHARD) Tj ET"),
        stream(b"BT /F1 24 Tf 35 55 Td (MEADOW) Tj ET"),
    ])


def check_png(path):
    data = path.read_bytes()
    assert data.startswith(b"\x89PNG\r\n\x1a\n")
    pos = 8
    pixels = bytearray()
    while pos < len(data):
        size, kind = struct.unpack_from(">I4s", data, pos)
        chunk = data[pos + 8:pos + 8 + size]
        crc, = struct.unpack_from(">I", data, pos + 8 + size)
        assert zlib.crc32(kind + chunk) == crc
        if pos == 8:
            assert kind == b"IHDR" and struct.unpack_from(">II", chunk) == (480, 240)
        if kind == b"IDAT":
            pixels.extend(chunk)
        pos += size + 12
        if kind == b"IEND":
            assert pos == len(data) and zlib.decompress(pixels)
            return
    raise ValueError("missing PNG end chunk")


def scan_from_pam(path, pam):
    header, pixels = pam.read_bytes().split(b"ENDHDR\n", 1)
    assert b"RGB_ALPHA" in header and len(pixels) == 480 * 240 * 4
    # Black type on opaque white paper. One colour channel gives the grey raster.
    write_pdf(path, [
        CATALOG, b"<< /Type /Pages /Kids [3 0 R] /Count 1 /MediaBox [0 0 240 120] >>",
        b"<< /Type /Page /Parent 2 0 R /Resources << /XObject << /Im 5 0 R >> >> /Contents 4 0 R >>",
        stream(b"q 240 0 0 120 0 0 cm /Im Do Q"),
        stream(zlib.compress(pixels[::4]), b"/Type /XObject /Subtype /Image /Width 480 /Height 240 "
               b"/BitsPerComponent 8 /ColorSpace /DeviceGray /Filter /FlateDecode"),
    ])


def smoke(binary, root):
    def cli(*args):
        return subprocess.check_output([binary, *args], cwd=root)

    fixture(root / "Two pages.pdf")
    assert json.loads(cli("info", "Two pages.pdf"))["pages"] == 2
    assert cli("text", "Two pages.pdf").split() == [b"ORCHARD", b"MEADOW"]
    for fmt in ("png", "pam"):
        cli("render", "Two pages.pdf", "--page", "1", "--dpi", "144", "--out", "page." + fmt)
    check_png(root / "page.png")
    cli("extract", "Two pages.pdf", "--pages", "2", "--out", "one.pdf")
    assert json.loads(cli("info", "one.pdf"))["pages"] == 1
    assert cli("text", "one.pdf").strip() == b"MEADOW"
    scan_from_pam(root / "scan.pdf", root / "page.pam")
    assert not cli("text", "scan.pdf").strip()

    with subprocess.Popen([binary, "mcp", "--root", root], cwd=root, stdin=subprocess.PIPE,
                          stdout=subprocess.PIPE, text=True) as server:
        sequence = 0

        def request(method, params):
            nonlocal sequence
            sequence += 1
            msg = dict(jsonrpc="2.0", id=sequence, method=method, params=params)
            server.stdin.write(json.dumps(msg) + "\n")
            server.stdin.flush()
            reply = json.loads(server.stdout.readline())
            assert reply["id"] == sequence and "error" not in reply, reply
            return reply["result"]

        def call(name, **arguments):
            result = request("tools/call", dict(name=name, arguments=arguments))
            assert not result.get("isError"), result
            return result["structuredContent"]

        try:
            hello = request("initialize", dict(protocolVersion="2025-03-26", capabilities={},
                                               clientInfo=dict(name="ports-test", version="1")))
            assert "tools" in hello["capabilities"]
            server.stdin.write('{"jsonrpc":"2.0","method":"notifications/initialized"}\n')
            server.stdin.flush()
            tools = {t["name"] for t in request("tools/list", {})["tools"]}
            assert {"doc_open", "page_delete", "doc_save", "doc_close", "ocr_recognize"} <= tools
            doc = call("doc_open", path="Two pages.pdf")["doc"]
            call("page_delete", doc=doc, pages=[2])
            call("doc_save", doc=doc, path="edited.pdf")
            call("doc_close", doc=doc)
            assert call("doc_open", path="edited.pdf")["pages"] == 1
            assert cli("text", "edited.pdf").strip() == b"ORCHARD"
            doc = call("doc_open", path="scan.pdf")["doc"]
            call("ocr_recognize", doc=doc, engine="ocrs", strategy="primary", dpi=144)
            call("doc_save", doc=doc, path="searchable.pdf")
            assert b"ORCHARD" in cli("text", "searchable.pdf").upper().split()
        finally:
            server.stdin.close()
        assert server.wait(timeout=10) == 0
    print("PDF info, extraction, rendering, headless MCP edit and built-in OCR passed")


if __name__ == "__main__":
    if len(sys.argv) == 3 and sys.argv[1] == "--fixture":
        fixture(Path(sys.argv[2]))
    elif len(sys.argv) == 2:
        binary = Path(sys.argv[1]).resolve(strict=True)
        for model in ("text-detection.onnx", "text-recognition.onnx"):
            assert (binary.parent.parent / "share/pdfcraft/models" / model).is_file(), model
        with tempfile.TemporaryDirectory() as tmp:
            for key in ("DISPLAY", "WAYLAND_DISPLAY", "PDFCRAFT_MODELS"):
                os.environ.pop(key, None)
            os.environ.update(HOME=tmp, TMPDIR=tmp, XDG_CONFIG_HOME=tmp, XDG_CACHE_HOME=tmp)
            smoke(binary, Path(tmp))
    else:
        sys.exit("usage: python3 smoke-test /path/to/bin/pdfcraft-cli | --fixture FILE")
